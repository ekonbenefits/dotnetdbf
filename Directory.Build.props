<Project>
  <PropertyGroup>
    <!--
      Without this, a project's language version comes from its target framework: net472 and
      netstandard2.0 default to C# 7.3, so the libraries and the net48 test leg were compiling
      as C# 7.3 while the net10.0 leg got C# 14. That divergence is invisible until something
      depends on it - NUnit 4.6 steers Assert.Throws with [OverloadResolutionPriority], which
      C# 7.3 ignores, and the net48 leg alone failed with twenty ambiguity errors.
    -->
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    The version comes from git tags (MinVer): a commit tagged v8.1.0 builds as 8.1.0, and one
    N commits past it as 8.1.1-alpha.0.N, so every CI build sorts above the last release.
    The minimum covers the old four-part tags (v7.0.1.0), which are not SemVer and which
    MinVer therefore ignores - until the first v8.x tag, builds are 8.0.0-alpha.0.N.
    Needs full history to see the tags: CI checks out with fetch-depth: 0.
  -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>8.0</MinVerMinimumMajorMinor>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <!--
    Building a net4x target off Windows works only where the .NET Framework reference
    assemblies can be found - today that is Mono, which happens to be on the hosted runner
    images. This package supplies them itself, so the build does not depend on what an image
    ships. Build-time only; it is in no package's dependencies.
  -->
  <ItemGroup Condition="$(TargetFramework.StartsWith('net4'))">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

</Project>
